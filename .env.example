# Secret untuk menandatangani cookie sesi (JWT). WAJIB diganti di produksi.
SESSION_SECRET=ubah-secret-ini-menjadi-acak-dan-panjang

# Path database SQLite lokal (dipakai saat dev / adapter-auto).
DATABASE_PATH=./data/app.db

# Kredensial superadmin awal (dipakai oleh `bun run db:seed`).
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@presensi.local
SUPERADMIN_PASSWORD=superadmin123
